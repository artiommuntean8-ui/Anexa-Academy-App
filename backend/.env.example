# ==============================================================================
# Academy Student Dashboard - Backend Environment Configuration
# ==============================================================================

PROJECT_NAME="Academy Student Dashboard API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# CORS Configuration (JSON array or comma-separated list)
BACKEND_CORS_ORIGINS=["http://localhost", "http://localhost:3000", "http://localhost:8000", "http://127.0.0.1:8000"]

# Database Configuration (Defaults to local SQLite for instant zero-dependency setup)
DATABASE_URL=sqlite:///./arkitech_dashboard.db

# To use PostgreSQL in production, uncomment and customize:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/arkitech_dashboard
